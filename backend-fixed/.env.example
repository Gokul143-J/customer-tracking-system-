# ============================================
# Jewellery CRM - Backend Environment
# ============================================
# Copy this file to .env and fill in your values.
# For Docker Compose, see docker-compose.yml — these env vars are passed in automatically.

APP_NAME=Jewellery CRM
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

HOST=0.0.0.0
PORT=8000
# In Docker, services are reachable by their service name: postgres, redis
# Frontend runs on http://localhost:3000 (and 3001, 5173 if you use other dev servers)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# ---- Database ----
# Use "postgres" as hostname when running with docker-compose
# Use "localhost" when running backend locally on your host
DATABASE_URL=postgresql+asyncpg://jewellery_admin:jewellery_secure_2026@postgres:5432/jewellery_crm
DATABASE_URL_LOCAL=postgresql+asyncpg://jewellery_admin:jewellery_secure_2026@localhost:5432/jewellery_crm

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
REDIS_URL_LOCAL=redis://localhost:6379/0

# ---- JWT ----
JWT_SECRET_KEY=please-change-this-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- First Admin (auto-seeded on first start) ----
FIRST_ADMIN_EMAIL=admin@jewellerycrm.com
FIRST_ADMIN_PASSWORD=Admin@2026!Secure

# ---- Email ----
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@jewellerycrm.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# ---- Store ----
DEFAULT_STORE_NAME=Royal Jewellers
DEFAULT_STORE_GST=
